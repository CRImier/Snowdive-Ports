/dts-v1/;
/plugin/;

/{
	compatible = {{compat}};

	fragment@0 {
		target = <&{{i2c_bus_pointer}}>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			beepy_kbd: beepy_kbd@1f {
				#address-cells = <1>;
				compatible = "beepy-kbd";
				reg = <0x1F>;
				irq-gpio = <&{{int_ec_gpio_port_pointer}} {{int_ec_gpio_num}} 0x2>;
				interrupts = <{{int_ec_gpio_num}} 2>;
				interrupt-parent = <&{{int_ec_gpio_port_pointer}}>;
				interrupt-controller;
				#interrupt-cells = <1>;
			};
		};
	};
	__overrides__ {
		irq_pin = <&beepy_kbd>,"interrupts:0";
	};
};

