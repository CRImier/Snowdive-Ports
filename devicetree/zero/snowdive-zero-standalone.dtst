/dts-v1/;
/plugin/;

/ {
	compatible = {{compat}};

	fragment@0 {
		/* This fragment is required only if using interrupts */
		target = <&{{gpio_target}}>;
		__overlay__ {
			pca9535_pin_irq: pca9535_pin_irq {
				{{pin_prefix}}pins = {{int_a_gpio}};
				function = "irq";
				bias-pull-up;
			};
		};
	};

	fragment@1 {
		target = <&{{i2c_bus_pointer}}>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			/* first Snowdive expander */
			pca9535@24 {
				compatible = "nxp,pca9535";
				reg = <0x24>;
				status = "okay";
				gpio-controller;
				#gpio-cells = <2>;
				/* Below are optional properties for supporting interrupts */
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&{{int_a_gpio_port_pointer}}>;
				interrupts = <{{int_a_gpio}} 8>; /* IRQ_TYPE_EDGE_FALLING */
				pinctrl-names = "default";
				pinctrl-0 = <&pca9535_pin_irq>;

				/* first 16 GPIOs are for GPIO expander 1 */
				{% for gpio in gpios %} {% if gpio < 16 and gpios[gpio]["type"] == "out" %}
				{{gpios[gpio]["name"]}}-hog {
			                gpio-hog;
			                gpios = <{{gpio}} 0>;
			                {{"output-high" if gpios[gpio].get("state", False) else "output-low"}};
			                line-name = "{{gpios[gpio]["name"]}}";
				};
				{%endif%} {% endfor %}
			};
		};
	};
};
